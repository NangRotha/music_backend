# KhmerBeats Music Store - Backend Environment Variables Example
PORT=8000
HOST=0.0.0.0

# Database (Stored in backend folder)
DATABASE_URL=sqlite:///./backend/music_store.db

# Render Persistent Disk (optional) - keeps SQLite DB + uploads across deploys.
# When this is set the app stores its DB at $RENDER_DISK_PATH/music_store.db and
# serves uploads from $RENDER_DISK_PATH/uploads. Only needed on Render when a
# Persistent Disk is attached (paid instance type required).
# RENDER_DISK_PATH=/var/data

# JWT Authentication
JWT_SECRET_KEY=super_secret_music_store_jwt_key_2026_khmer_melody_32bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default Admin Credentials
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
